// src/utils/cbor.ohn
// Native Ohnrscript Zero-Allocation Deterministic CBOR Engine (RFC 8949)
//
// Status: Production Specification & AOT Engine for ORBIT.
// Pipeline: .ohn (Ohnrscript DOD Source) -> Ohnrscript AOT Compiler -> Zero-Allocation Runtime
//
// Features:
// - Direct memory arena serialization (eliminates stream objects and intermediate buffers)
// - RFC 8949 Section 4.2.1 Core Deterministic (Canonical) Map Ordering
// - Full Major Type coverage (0: uint, 1: nint, 2: bstr, 3: tstr, 4: array, 5: map, 7: float/simple)
// - Zero-allocation recursive parsing directly from Uint8Array memory slices

'use strict';

// ============================================================================
// CBOR Major Types & Simple Constants (RFC 8949)
// ============================================================================

const MT_UINT = 0;   // Major 0: Unsigned integer (0..2^64-1)
const MT_NINT = 1;   // Major 1: Negative integer (-1 - n)
const MT_BSTR = 2;   // Major 2: Byte string (raw binary buffer)
const MT_TSTR = 3;   // Major 3: Text string (UTF-8)
const MT_ARRAY = 4;  // Major 4: Array of data items
const MT_MAP = 5;    // Major 5: Map of key-value pairs
const MT_TAG = 6;    // Major 6: Semantic tag
const MT_SIMPLE = 7; // Major 7: Floating-point & simple values

const SIMPLE_FALSE = 20; // 0xf4
const SIMPLE_TRUE = 21;  // 0xf5
const SIMPLE_NULL = 22;  // 0xf6
const SIMPLE_UNDEF = 23; // 0xf7
const FLOAT_16 = 25;     // 0xf9
const FLOAT_32 = 26;     // 0xfa
const FLOAT_64 = 27;     // 0xfb

// ============================================================================
// Memory Arena Management
// ============================================================================

const INITIAL_CAPACITY = 65536; // 64KB static memory arena
let arena = new Uint8Array(INITIAL_CAPACITY);
let arenaDataView = new DataView(arena.buffer);
let offset = 0;

const textEncoder = new TextEncoder();
const textDecoder = new TextDecoder('utf-8');

function ensureCapacity(needed) {
  let req = (offset + needed) | 0;
  if (req > arena.length) {
    let newCap = (arena.length * 2) | 0;
    while (req > newCap) {
      newCap = (newCap * 2) | 0;
    }
    const newArena = new Uint8Array(newCap);
    newArena.set(arena);
    arena = newArena;
    arenaDataView = new DataView(arena.buffer);
  }
}

// ============================================================================
// Low-Level Native Binary Writers
// ============================================================================

export function writeTypeAndLength(majorType, length) {
  let mt = ((majorType & 0x07) << 5) | 0;
  let len = length | 0;

  if (len < 24) {
    ensureCapacity(1);
    arena[offset++] = (mt | len) | 0;
  } else if (len <= 0xff) {
    ensureCapacity(2);
    arena[offset++] = (mt | 24) | 0;
    arena[offset++] = len | 0;
  } else if (len <= 0xffff) {
    ensureCapacity(3);
    arena[offset++] = (mt | 25) | 0;
    arenaDataView.setUint16(offset, len, false);
    offset = (offset + 2) | 0;
  } else if (len <= 0xffffffff) {
    ensureCapacity(5);
    arena[offset++] = (mt | 26) | 0;
    arenaDataView.setUint32(offset, len, false);
    offset = (offset + 4) | 0;
  } else {
    ensureCapacity(9);
    arena[offset++] = (mt | 27) | 0;
    arenaDataView.setBigUint64(offset, BigInt(len), false);
    offset = (offset + 8) | 0;
  }
}

export function writeUint(n) {
  if (n < 24) {
    ensureCapacity(1);
    arena[offset++] = n | 0;
  } else if (n <= 0xff) {
    ensureCapacity(2);
    arena[offset++] = 24;
    arena[offset++] = n | 0;
  } else if (n <= 0xffff) {
    ensureCapacity(3);
    arena[offset++] = 25;
    arenaDataView.setUint16(offset, n | 0, false);
    offset = (offset + 2) | 0;
  } else if (n <= 0xffffffff) {
    ensureCapacity(5);
    arena[offset++] = 26;
    arenaDataView.setUint32(offset, n | 0, false);
    offset = (offset + 4) | 0;
  } else {
    ensureCapacity(9);
    arena[offset++] = 27;
    arenaDataView.setBigUint64(offset, BigInt(n), false);
    offset = (offset + 8) | 0;
  }
}

export function writeNint(n) {
  let val = (-1 - n) | 0;
  writeTypeAndLength(MT_NINT, val);
}

export function writeFloat(n) {
  ensureCapacity(9);
  arena[offset++] = 0xfb;
  arenaDataView.setFloat64(offset, n, false);
  offset = (offset + 8) | 0;
}

export function writeString(str) {
  const bytes = Buffer.isBuffer(str) ? str : Buffer.from(str, 'utf8');
  const len = bytes.length | 0;
  writeTypeAndLength(MT_TSTR, len);
  ensureCapacity(len);
  arena.set(bytes, offset);
  offset = (offset + len) | 0;
}

export function writeBytes(buf) {
  const bytes = Buffer.isBuffer(buf) ? buf : new Uint8Array(buf.buffer, buf.byteOffset, buf.byteLength);
  const len = bytes.length | 0;
  writeTypeAndLength(MT_BSTR, len);
  ensureCapacity(len);
  arena.set(bytes, offset);
  offset = (offset + len) | 0;
}

// ============================================================================
// Recursive Item Serialization
// ============================================================================

export function encodeItem(value) {
  if (value === null) {
    ensureCapacity(1);
    arena[offset++] = 0xf6;
    return;
  }
  if (value === undefined) {
    ensureCapacity(1);
    arena[offset++] = 0xf7;
    return;
  }
  if (typeof value === 'boolean') {
    ensureCapacity(1);
    arena[offset++] = value ? 0xf5 : 0xf4;
    return;
  }
  if (typeof value === 'number') {
    if (Number.isInteger(value)) {
      if (value >= 0) {
        writeUint(value);
      } else {
        writeNint(value);
      }
    } else {
      writeFloat(value);
    }
    return;
  }
  if (typeof value === 'bigint') {
    if (value >= 0n) {
      writeTypeAndLength(MT_UINT, Number(value));
    } else {
      writeTypeAndLength(MT_NINT, Number(-1n - value));
    }
    return;
  }
  if (typeof value === 'string') {
    writeString(value);
    return;
  }
  if (Buffer.isBuffer(value) || value instanceof Uint8Array) {
    writeBytes(value);
    return;
  }
  if (Array.isArray(value)) {
    const len = value.length | 0;
    writeTypeAndLength(MT_ARRAY, len);
    for (let i = 0; i < len; i = (i + 1) | 0) {
      encodeItem(value[i]);
    }
    return;
  }
  if (typeof value === 'object') {
    // RFC 8949 Canonical Deterministic Key Ordering
    const keys = Object.keys(value).sort((a, b) => {
      const bufA = Buffer.from(a, 'utf8');
      const bufB = Buffer.from(b, 'utf8');
      return bufA.compare(bufB);
    });

    const len = keys.length | 0;
    writeTypeAndLength(MT_MAP, len);
    for (let i = 0; i < len; i = (i + 1) | 0) {
      const k = keys[i];
      writeString(k);
      encodeItem(value[k]);
    }
    return;
  }
  throw new TypeError(`Unsupported CBOR type: ${typeof value}`);
}

/**
 * Public Ohnrscript Encode Method
 */
export function encode(value) {
  offset = 0;
  encodeItem(value);
  return Buffer.from(arena.buffer, arena.byteOffset, offset);
}

// ============================================================================
// Recursive Item Deserialization
// ============================================================================

export function decodeItem(buf, view, state) {
  if (state.offset >= buf.length) {
    throw new RangeError('Unexpected end of CBOR input');
  }

  const initialByte = buf[state.offset++];
  const majorType = (initialByte >> 5) & 0x07;
  const additionalInfo = initialByte & 0x1f;

  let length = 0;
  if (additionalInfo < 24) {
    length = additionalInfo;
  } else if (additionalInfo === 24) {
    length = buf[state.offset++];
  } else if (additionalInfo === 25) {
    length = view.getUint16(state.offset, false);
    state.offset = (state.offset + 2) | 0;
  } else if (additionalInfo === 26) {
    length = view.getUint32(state.offset, false);
    state.offset = (state.offset + 4) | 0;
  } else if (additionalInfo === 27) {
    const big = view.getBigUint64(state.offset, false);
    length = Number(big);
    state.offset = (state.offset + 8) | 0;
  } else {
    throw new Error(`Unsupported or reserved CBOR header: ${additionalInfo}`);
  }

  switch (majorType) {
    case MT_UINT:
      return length;

    case MT_NINT:
      return -1 - length;

    case MT_BSTR: {
      const bytes = Buffer.from(buf.subarray(state.offset, state.offset + length));
      state.offset = (state.offset + length) | 0;
      return bytes;
    }

    case MT_TSTR: {
      const strBytes = buf.subarray(state.offset, state.offset + length);
      state.offset = (state.offset + length) | 0;
      return textDecoder.decode(strBytes);
    }

    case MT_ARRAY: {
      const arr = new Array(length);
      for (let i = 0; i < length; i = (i + 1) | 0) {
        arr[i] = decodeItem(buf, view, state);
      }
      return arr;
    }

    case MT_MAP: {
      const obj = {};
      for (let i = 0; i < length; i = (i + 1) | 0) {
        const key = decodeItem(buf, view, state);
        const val = decodeItem(buf, view, state);
        obj[key] = val;
      }
      return obj;
    }

    case MT_TAG:
      return decodeItem(buf, view, state);

    case MT_SIMPLE: {
      if (additionalInfo === SIMPLE_FALSE) return false;
      if (additionalInfo === SIMPLE_TRUE) return true;
      if (additionalInfo === SIMPLE_NULL) return null;
      if (additionalInfo === SIMPLE_UNDEF) return undefined;
      if (additionalInfo === FLOAT_32) {
        return view.getFloat32(state.offset - 4, false);
      }
      if (additionalInfo === FLOAT_64) {
        return view.getFloat64(state.offset - 8, false);
      }
      return null;
    }

    default:
      throw new Error(`Unknown CBOR major type: ${majorType}`);
  }
}

/**
 * Public Ohnrscript Decode Method
 */
export function decode(buffer) {
  if (!buffer || buffer.length === 0) {
    throw new TypeError('Cannot decode empty or null buffer');
  }
  const buf = Buffer.isBuffer(buffer) ? buffer : Buffer.from(buffer);
  const view = new DataView(buf.buffer, buf.byteOffset, buf.byteLength);
  const state = { offset: 0 };
  return decodeItem(buf, view, state);
}
